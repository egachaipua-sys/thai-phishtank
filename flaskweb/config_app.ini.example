[app]
SECRET_KEY = your_secret_key_here
DEBUG = True
# Comma-separated API keys for service / admin accounts that should NOT
# appear in the user-management table. Leave blank if you don't need it.
HIDDEN_API_KEYS =
# Cookie hardening. SESSION_COOKIE_SECURE should be True in production
# (requires HTTPS); leave False for local HTTP development.
SESSION_COOKIE_SAMESITE = Lax
SESSION_COOKIE_SECURE = False

[database]
MONGO_URI = mongodb://localhost:27017/
DB_NAME = phishtank_th

[email]
MAIL_SERVER = smtp.gmail.com
MAIL_PORT = 587
MAIL_USE_TLS = True
MAIL_USERNAME = your_email@gmail.com
MAIL_PASSWORD = your_app_password

[api]
GOOGLE_SAFE_BROWSING_KEY = your_google_safe_browsing_key
API_KEY = your_internal_api_key
